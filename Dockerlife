# 1. Gunakan Node.js untuk Build
FROM node:20-alpine AS builder
WORKDIR /app
COPY package*.json ./
RUN npm install
COPY . .
RUN npm run build

# 2. Gunakan Node.js ringan untuk Serving
FROM node:20-alpine
WORKDIR /app
RUN npm install -g serve
# Salin hasil build dari tahap 1 (jika pakai Vite otomatis ke folder 'dist')
COPY --from=builder /app/dist ./dist

# Cloud Run mendengarkan port 8080 secara default
EXPOSE 8080

# Jalankan 'serve' dengan mode Single Page App (-s) pada port 8080
CMD ["serve", "-s", "dist", "-l", "8080"]